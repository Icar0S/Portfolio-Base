{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs",
      "startServerReadyPattern": "Servindo",
      "url": [
        "http://127.0.0.1:4173/Portfolio-Base/",
        "http://127.0.0.1:4173/Portfolio-Base/en/",
        "http://127.0.0.1:4173/Portfolio-Base/projetos/smartdatatest/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
