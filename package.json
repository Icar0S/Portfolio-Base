{
  "name": "icaro-santos-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfólio de Ícaro Santos — QA Engineer, desenvolvedor fullstack e pesquisador em IA",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/generate-og.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lhci": "lhci autorun",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "framer-motion": "14.5.0",
    "lenis": "1.3.27",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
